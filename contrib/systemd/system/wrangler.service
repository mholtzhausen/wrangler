[Unit]
Description=Wrangler process CPU throttle daemon (system)
Documentation=https://github.com/mholtzhausen/wrangler
After=network-online.target
# Session paths and Environment lines are written at install time for the installing user.

[Service]
Type=simple
ExecStart=/usr/local/bin/wrangler --daemon --foreground --cgroups
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
